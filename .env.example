DEBUG=true
SECRET_KEY=change-me
# Ключ подписи JWT: для HS256 — не короче 32 байт
JWT_SECRET_KEY=change-me-jwt-signing-key-at-least-32-bytes
ALLOWED_HOSTS=localhost,127.0.0.1
# Без DATABASE_URL используется локальный SQLite (db.sqlite3)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meetups
CORS_ALLOWED_ORIGINS=http://localhost:5173
